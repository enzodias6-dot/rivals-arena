NODE_ENV=development
PORT=3000
TRUST_PROXY=

# Use somente a URL do projeto e a chave anon/publicável do Supabase.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sb_publishable_substitua-pela-chave-publica
# Alternativamente, use SUPABASE_PUBLISHABLE_KEY no lugar de SUPABASE_ANON_KEY.

# Opcional: necessário somente para exclusão administrativa de conta.
# Cadastre o segredo no ambiente do servidor/Vercel; nunca no frontend.
# SUPABASE_SERVICE_ROLE_KEY=
