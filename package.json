{
  "name": "rivals-arena",
  "version": "2.0.0",
  "private": true,
  "description": "Projeto acadêmico Rivals Arena: torneios 1V1, ranking e perfil de combatentes.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:preparar": "node scripts/preparar-banco.js",
    "segredo": "node scripts/gerar-segredo.js",
    "check": "node scripts/verificar-sintaxe.js && node scripts/verificar-links.js",
    "test:api": "node --test tests/api.test.js",
    "test": "npm run check && npm run test:api"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
